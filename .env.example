# Copy to .env.local for local overrides; set the same keys in Vercel → Settings → Environment Variables.
# Nothing here is required for local dev: without DATABASE_URL the app uses an in-memory PGLite database.

# --- Required in production ---
# Neon (free tier) connection string. Migrations run on every `npm run build`.
DATABASE_URL=
# Random 32+ characters, e.g. `openssl rand -hex 32`. Changing it signs everyone out.
BETTER_AUTH_SECRET=
# Public URL if you use a custom domain (defaults to the Vercel production domain).
BETTER_AUTH_URL=
# Extra origins allowed to sign in, comma separated (e.g. a second custom domain).
TRUSTED_ORIGINS=

# --- AI (tried in this order; set at least one) ---
# Free: https://console.groq.com/keys
GROQ_API_KEY=
# Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
# Optional model overrides: GROQ_MODEL, GEMINI_MODEL, OPENAI_MODEL, XAI_MODEL

# --- Anonymous Connect realtime (optional; polling works without it) ---
# Free tier: https://ably.com → app → API keys (needs publish + subscribe + token capabilities).
ABLY_API_KEY=

# --- Moderation ---
# Emails that are always admins (comma separated). Others can be promoted with:
#   update profiles set role = 'moderator' where user_id = '<user id>';
ADMIN_EMAILS=

# --- Optional social sign-in ---
# Google: redirect URI https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# X: redirect URI https://<your-domain>/api/auth/callback/twitter
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
